<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Mavenium 父工程（版本由父工程统一管理） -->
    <parent>
        <groupId>com.mavenium</groupId>
        <artifactId>Mavenium</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>service-common</artifactId>
    <name>service-common</name>
    <description>公共模块：统一响应体、状态码、业务异常与全局异常处理</description>

    <dependencies>
        <!-- Spring WebMVC：提供 @RestControllerAdvice、MethodArgumentNotValidException、BindException 等
             （版本由 Boot BOM 管理；运行时由各服务的 spring-boot-starter-web 提供完整 Web 栈） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- Jackson 注解：@JsonInclude（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- SLF4J 日志门面：@Slf4j 生成 log 字段所需（版本由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式指定注解处理器，确保 Lombok 在任何环境下都能生效 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
